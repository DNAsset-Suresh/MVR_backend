DATABASE_URL=postgresql://mvr:CHANGE_ME@127.0.0.1:5432/mvr
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
HOST=127.0.0.1
TRUST_PROXY=0
# Initial administrator bootstrap credentials (scripts/create-admin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=MVR Administrator
# SMTP is required for password reset emails and email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MVR <bookings@example.com>
ADMIN_NOTIFICATION_EMAIL=
# Optional WhatsApp Business template notifications. Requires recipient opt-in.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Google Calendar OAuth credentials (server only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
UPLOAD_DIR=.local/uploads
# Tests require a separate disposable PostgreSQL database.
TEST_DATABASE_URL=
# Docker only: generate distinct long URL-safe random passwords.
MVR_ENV_FILE=.env
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Production domain for Caddy, e.g. bookings.your-domain.example
DOMAIN=
# Optional JARVIS AI (server only). Leave the key empty for website-only answers.
# Configure a supported Responses API model in your OpenAI project.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Tamil speech: Microsoft Azure AI Speech, server only. No key/token reaches browsers.
# Use the region belonging to your Speech resource (for example centralindia).
# The SDK derives the trusted regional service endpoints from this region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ta-IN-ValluvarNeural
# Supported alternative: ta-IN-PallaviNeural
## JARVIS conversational replies (server only). Never expose this key in frontend files.
# Free-tier quotas/data policies and paid usage rates: https://ai.google.dev/gemini-api/docs/pricing
# Adding a key enables requests after the visitor accepts the activation disclosure.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
